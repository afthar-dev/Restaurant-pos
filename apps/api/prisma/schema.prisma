generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaxScheme {
  REGULAR
  COMPOSITION
  NONE
}

enum Role {
  OWNER
  MANAGER
  CASHIER
  WAITER
}

enum DeviceType {
  POS
  CAPTAIN
  KDS
  PRINT_AGENT
}

enum ParcelPaymentTiming {
  PAY_FIRST
  PAY_AT_PICKUP
}

enum FoodType {
  VEG
  NON_VEG
  EGG
}

enum PrinterPurpose {
  KOT
  BILL
}

enum PrinterMode {
  BROWSER
  AGENT
}

model Outlet {
  id                      String              @id @default(uuid()) @db.Uuid
  name                    String
  gstin                   String?
  taxScheme               TaxScheme           @default(REGULAR) @map("tax_scheme")
  address                 String?
  phone                   String?
  fssaiNumber             String?             @map("fssai_number")
  billHeader              String?             @map("bill_header")
  billFooter              String?             @map("bill_footer")
  /// Highest discount a cashier may give without a manager, in basis points (1000 = 10%).
  cashierDiscountCapBp    Int                 @default(1000) @map("cashier_discount_cap_bp")
  waiterCanCollectPayment Boolean             @default(false) @map("waiter_can_collect_payment")
  parcelPaymentTiming     ParcelPaymentTiming @default(PAY_FIRST) @map("parcel_payment_timing")
  /// Paise added once to each parcel order's bill.
  billPackagingCharge     Int                 @default(0) @map("bill_packaging_charge")
  /// The restaurant logo: staff header, printed bills, QR menu.
  logoId                  String?             @map("logo_id") @db.Uuid
  logo                    Media?              @relation("OutletLogo", fields: [logoId], references: [id], onDelete: SetNull)
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  users             User[]
  devices           Device[]
  auditEntries      AuditEntry[]
  taxRates          TaxRate[]
  stations          Station[]
  printers          Printer[]
  areas             Area[]
  tables            DiningTable[]
  categories        Category[]
  items             Item[]
  addonGroups       AddonGroup[]
  businessDays      BusinessDay[]
  media             Media[]           @relation("OutletMedia")
  orders            Order[]
  bills             Bill[]
  qrSessions        QrSession[]
  qrSubmissions     QrSubmission[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  stockItems        StockItem[]
  stockTxns         StockTxn[]
  purchases         Purchase[]

  @@map("outlets")
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  outletId       String    @map("outlet_id") @db.Uuid
  name           String
  phone          String    @unique
  role           Role
  passwordHash   String?   @map("password_hash")
  pinHash        String?   @map("pin_hash")
  /// Consecutive wrong PINs (sign-in or approval). Reset on success.
  pinFailedCount Int       @default(0) @map("pin_failed_count")
  pinLockedUntil DateTime? @map("pin_locked_until") @db.Timestamptz(3)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlet           Outlet            @relation(fields: [outletId], references: [id])
  refreshSessions  RefreshSession[]
  devicesCreated   Device[]
  auditEntries     AuditEntry[]
  passwordAttempts PasswordAttempt[]
  daysOpened       BusinessDay[]     @relation("DayOpenedBy")
  ordersAsWaiter   Order[]           @relation("OrderWaiter")
  ordersCreated    Order[]           @relation("OrderCreatedBy")
  kotsCreated      Kot[]             @relation("KotCreatedBy")
  billsCreated     Bill[]            @relation("BillCreatedBy")
  paymentsReceived Payment[]         @relation("PaymentReceivedBy")
  paymentsRefunded Payment[]         @relation("PaymentRefundedBy")
  daysClosed       BusinessDay[]     @relation("DayClosedBy")
  qrDecisions      QrSubmission[]    @relation("QrDecidedBy")
  expensesCreated  Expense[]         @relation("ExpenseCreatedBy")
  expensesVoided   Expense[]         @relation("ExpenseVoidedBy")
  stockTxns        StockTxn[]
  purchasesCreated Purchase[]        @relation("PurchaseCreatedBy")
  purchasesVoided  Purchase[]        @relation("PurchaseVoidedBy")

  @@index([outletId])
  @@map("users")
}

model Device {
  id          String     @id @default(uuid()) @db.Uuid
  outletId    String     @map("outlet_id") @db.Uuid
  name        String
  type        DeviceType
  tokenHash   String     @unique @map("token_hash")
  createdById String     @map("created_by_id") @db.Uuid
  lastSeenAt  DateTime?  @map("last_seen_at") @db.Timestamptz(3)
  revokedAt   DateTime?  @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlet          Outlet           @relation(fields: [outletId], references: [id])
  createdBy       User             @relation(fields: [createdById], references: [id])
  refreshSessions RefreshSession[]
  printers        Printer[]

  @@index([outletId])
  @@map("devices")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  deviceId  String?   @map("device_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id])
  device Device? @relation(fields: [deviceId], references: [id])

  @@index([familyId])
  @@index([userId])
  @@map("refresh_sessions")
}

model AuditEntry {
  id        String   @id @default(uuid()) @db.Uuid
  outletId  String   @map("outlet_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  reason    String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlet Outlet @relation(fields: [outletId], references: [id])
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([outletId, createdAt(sort: Desc)])
  @@map("audit_entries")
}

/// Wrong-password counter per user and client address, so a stranger cannot lock an owner
/// out of every network by guessing from one.
model PasswordAttempt {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  ip          String
  failedCount Int       @default(0) @map("failed_count")
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, ip])
  @@map("password_attempts")
}

/// Manager override tokens already used. Each token authorises one action.
model UsedOverrideToken {
  jti       String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("used_override_tokens")
}

model TaxRate {
  id         String    @id @default(uuid()) @db.Uuid
  outletId   String    @map("outlet_id") @db.Uuid
  name       String
  cgstBp     Int       @map("cgst_bp")
  sgstBp     Int       @map("sgst_bp")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlet Outlet @relation(fields: [outletId], references: [id])
  items  Item[]

  @@index([outletId])
  @@map("tax_rates")
}

/// A kitchen section (main kitchen, tandoor, bar). KOTs are split per station.
model Station {
  id         String    @id @default(uuid()) @db.Uuid
  outletId   String    @map("outlet_id") @db.Uuid
  name       String
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlet     Outlet     @relation(fields: [outletId], references: [id])
  printers   Printer[]
  categories Category[]

  @@index([outletId])
  @@map("stations")
}

model Printer {
  id           String         @id @default(uuid()) @db.Uuid
  outletId     String         @map("outlet_id") @db.Uuid
  name         String
  purpose      PrinterPurpose
  stationId    String?        @map("station_id") @db.Uuid
  mode         PrinterMode    @default(BROWSER)
  paperWidthMm Int            @default(80) @map("paper_width_mm")
  address      String?
  /// The device (browser or print agent) that prints this printer's jobs.
  deviceId     String?        @map("device_id") @db.Uuid
  archivedAt   DateTime?      @map("archived_at") @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlet  Outlet     @relation(fields: [outletId], references: [id])
  station Station?   @relation(fields: [stationId], references: [id])
  device  Device?    @relation(fields: [deviceId], references: [id])
  jobs    PrintJob[]

  @@index([outletId])
  @@map("printers")
}

model Area {
  id         String    @id @default(uuid()) @db.Uuid
  outletId   String    @map("outlet_id") @db.Uuid
  name       String
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlet Outlet        @relation(fields: [outletId], references: [id])
  tables DiningTable[]

  @@index([outletId])
  @@map("areas")
}

model DiningTable {
  id         String    @id @default(uuid()) @db.Uuid
  outletId   String    @map("outlet_id") @db.Uuid
  areaId     String    @map("area_id") @db.Uuid
  name       String
  seats      Int
  /// Secret printed in the table QR code (rotated from M4).
  qrToken    String    @unique @map("qr_token")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlet        Outlet         @relation(fields: [outletId], references: [id])
  area          Area           @relation(fields: [areaId], references: [id])
  orders        Order[]
  qrSessions    QrSession[]
  qrSubmissions QrSubmission[]

  @@index([outletId])
  @@index([areaId])
  @@map("tables")
}

model Category {
  id         String    @id @default(uuid()) @db.Uuid
  outletId   String    @map("outlet_id") @db.Uuid
  stationId  String    @map("station_id") @db.Uuid
  name       String
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlet  Outlet  @relation(fields: [outletId], references: [id])
  station Station @relation(fields: [stationId], references: [id])
  items   Item[]

  @@index([outletId])
  @@map("categories")
}

model Item {
  id          String    @id @default(uuid()) @db.Uuid
  outletId    String    @map("outlet_id") @db.Uuid
  categoryId  String    @map("category_id") @db.Uuid
  /// Null for a no-GST dish: its price is charged as it is.
  taxRateId   String?   @map("tax_rate_id") @db.Uuid
  name        String
  description String?
  foodType    FoodType  @map("food_type")
  isCombo     Boolean   @default(false) @map("is_combo")
  isAvailable Boolean   @default(true) @map("is_available")
  sortOrder   Int       @default(0) @map("sort_order")
  /// The dish photo shown on the QR menu.
  imageId     String?   @map("image_id") @db.Uuid
  image       Media?    @relation(fields: [imageId], references: [id], onDelete: SetNull)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlet      Outlet           @relation(fields: [outletId], references: [id])
  category    Category         @relation(fields: [categoryId], references: [id])
  taxRate     TaxRate?         @relation(fields: [taxRateId], references: [id], onDelete: Restrict)
  variants    ItemVariant[]
  addonGroups ItemAddonGroup[]
  components  ComboComponent[] @relation("ComboItem")

  @@index([outletId])
  @@index([categoryId])
  @@map("items")
}

model ItemVariant {
  id              String    @id @default(uuid()) @db.Uuid
  itemId          String    @map("item_id") @db.Uuid
  name            String
  dineInPrice     Int       @map("dine_in_price")
  parcelPrice     Int       @map("parcel_price")
  packagingCharge Int       @default(0) @map("packaging_charge")
  sortOrder       Int       @default(0) @map("sort_order")
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  item         Item             @relation(fields: [itemId], references: [id])
  usedInCombos ComboComponent[] @relation("ComponentVariant")
  orderItems   OrderItem[]

  @@index([itemId])
  @@map("item_variants")
}

model AddonGroup {
  id         String    @id @default(uuid()) @db.Uuid
  outletId   String    @map("outlet_id") @db.Uuid
  name       String
  minSelect  Int       @default(0) @map("min_select")
  maxSelect  Int       @default(1) @map("max_select")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlet Outlet           @relation(fields: [outletId], references: [id])
  addons Addon[]
  items  ItemAddonGroup[]

  @@index([outletId])
  @@map("addon_groups")
}

model Addon {
  id          String    @id @default(uuid()) @db.Uuid
  groupId     String    @map("group_id") @db.Uuid
  name        String
  price       Int
  isAvailable Boolean   @default(true) @map("is_available")
  sortOrder   Int       @default(0) @map("sort_order")
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  group AddonGroup @relation(fields: [groupId], references: [id])

  @@index([groupId])
  @@map("addons")
}

model ItemAddonGroup {
  itemId    String   @map("item_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  item  Item       @relation(fields: [itemId], references: [id])
  group AddonGroup @relation(fields: [groupId], references: [id])

  @@id([itemId, groupId])
  @@map("item_addon_groups")
}

/// One line of a combo: N of a variant of another (non-combo) item.
model ComboComponent {
  id          String   @id @default(uuid()) @db.Uuid
  comboItemId String   @map("combo_item_id") @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
  quantity    Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  comboItem Item        @relation("ComboItem", fields: [comboItemId], references: [id])
  variant   ItemVariant @relation("ComponentVariant", fields: [variantId], references: [id])

  @@index([comboItemId])
  @@map("combo_components")
}

enum BusinessDayStatus {
  OPEN
  CLOSED
}

enum OrderType {
  DINE_IN
  PARCEL
}

enum OrderSource {
  POS
  CAPTAIN
  QR
}

enum OrderStatus {
  PENDING_APPROVAL
  OPEN
  BILLED
  CLOSED
  CANCELLED
}

enum OrderItemStatus {
  NEW
  SENT
  CANCELLED
}

enum KotType {
  NEW
  CANCEL
}

enum KotStatus {
  NEW
  PREPARING
  READY
  SERVED
}

enum PrintJobKind {
  KOT
  BILL
}

enum PrintJobStatus {
  PENDING
  PRINTED
  FAILED
}

model BusinessDay {
  id           String            @id @default(uuid()) @db.Uuid
  outletId     String            @map("outlet_id") @db.Uuid
  status       BusinessDayStatus @default(OPEN)
  openingCash  Int               @map("opening_cash")
  openedById   String            @map("opened_by_id") @db.Uuid
  openedAt     DateTime          @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedById   String?           @map("closed_by_id") @db.Uuid
  closedAt     DateTime?         @map("closed_at") @db.Timestamptz(3)
  expectedCash Int?              @map("expected_cash")
  countedCash  Int?              @map("counted_cash")
  variance     Int?
  closeNote    String?           @map("close_note")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlet    Outlet     @relation(fields: [outletId], references: [id])
  openedBy  User       @relation("DayOpenedBy", fields: [openedById], references: [id])
  closedBy  User?      @relation("DayClosedBy", fields: [closedById], references: [id])
  orders    Order[]
  kots      Kot[]
  bills     Bill[]
  payments  Payment[]
  refunds   Payment[]  @relation("PaymentRefundDay")
  expenses  Expense[]
  purchases Purchase[]

  @@index([outletId, status])
  @@map("business_days")
}

/// Gap-free sequence numbers (KOT, parcel token, bill) per outlet, key and period.
model Counter {
  id        String   @id @default(uuid()) @db.Uuid
  outletId  String   @map("outlet_id") @db.Uuid
  key       String
  period    String
  value     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([outletId, key, period])
  @@map("counters")
}

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  outletId      String      @map("outlet_id") @db.Uuid
  businessDayId String      @map("business_day_id") @db.Uuid
  type          OrderType
  source        OrderSource
  status        OrderStatus @default(OPEN)
  tableId       String?     @map("table_id") @db.Uuid
  tokenNo       Int?        @map("token_no")
  guests        Int?
  customerName  String?     @map("customer_name")
  waiterId      String?     @map("waiter_id") @db.Uuid
  createdById   String?     @map("created_by_id") @db.Uuid
  version       Int         @default(0)
  cancelReason  String?     @map("cancel_reason")
  cancelledById String?     @map("cancelled_by_id") @db.Uuid
  closedAt      DateTime?   @map("closed_at") @db.Timestamptz(3)
  /// Set when this order was merged into another; its table stays held by that order.
  mergedIntoId  String?     @map("merged_into_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlet        Outlet         @relation(fields: [outletId], references: [id])
  businessDay   BusinessDay    @relation(fields: [businessDayId], references: [id])
  table         DiningTable?   @relation(fields: [tableId], references: [id])
  waiter        User?          @relation("OrderWaiter", fields: [waiterId], references: [id])
  createdBy     User?          @relation("OrderCreatedBy", fields: [createdById], references: [id])
  items         OrderItem[]
  kots          Kot[]
  bills         Bill[]
  qrSubmissions QrSubmission[]
  mergedInto    Order?         @relation("OrderMerge", fields: [mergedIntoId], references: [id])
  mergedFrom    Order[]        @relation("OrderMerge")

  @@index([outletId, status])
  @@index([tableId, status])
  @@index([businessDayId])
  @@index([mergedIntoId])
  @@map("orders")
}

model OrderItem {
  id              String          @id @default(uuid()) @db.Uuid
  orderId         String          @map("order_id") @db.Uuid
  itemId          String          @map("item_id") @db.Uuid
  variantId       String          @map("variant_id") @db.Uuid
  itemName        String          @map("item_name")
  variantName     String          @map("variant_name")
  unitPrice       Int             @map("unit_price")
  /// Per unit; parcel orders only.
  packagingCharge Int             @default(0) @map("packaging_charge")
  /// Null when the dish had no GST (cgstBp and sgstBp are then 0).
  taxRateId       String?         @map("tax_rate_id") @db.Uuid
  cgstBp          Int             @map("cgst_bp")
  sgstBp          Int             @map("sgst_bp")
  quantity        Int
  /// [{id, name, price}] at the time of ordering.
  addons          Json            @default("[]")
  /// [{itemName, variantName, quantity}] per one combo, for KOTs.
  comboComponents Json            @default("[]") @map("combo_components")
  note            String?
  stationId       String          @map("station_id") @db.Uuid
  status          OrderItemStatus @default(NEW)
  kotId           String?         @map("kot_id") @db.Uuid
  cancelReason    String?         @map("cancel_reason")
  cancelledById   String?         @map("cancelled_by_id") @db.Uuid
  createdById     String          @map("created_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  order     Order       @relation(fields: [orderId], references: [id])
  variant   ItemVariant @relation(fields: [variantId], references: [id])
  kot       Kot?        @relation("KotItems", fields: [kotId], references: [id])
  billItems BillItem[]

  @@index([orderId])
  @@map("order_items")
}

model Kot {
  id            String    @id @default(uuid()) @db.Uuid
  outletId      String    @map("outlet_id") @db.Uuid
  businessDayId String    @map("business_day_id") @db.Uuid
  orderId       String    @map("order_id") @db.Uuid
  kotNo         Int       @map("kot_no")
  type          KotType   @default(NEW)
  stationId     String    @map("station_id") @db.Uuid
  stationName   String    @map("station_name")
  status        KotStatus @default(NEW)
  createdById   String    @map("created_by_id") @db.Uuid
  readyAt       DateTime? @map("ready_at") @db.Timestamptz(3)
  servedAt      DateTime? @map("served_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  businessDay BusinessDay @relation(fields: [businessDayId], references: [id])
  order       Order       @relation(fields: [orderId], references: [id])
  createdBy   User        @relation("KotCreatedBy", fields: [createdById], references: [id])
  lines       KotLine[]
  items       OrderItem[] @relation("KotItems")
  printJobs   PrintJob[]

  @@index([outletId, businessDayId, status])
  @@index([orderId])
  @@map("kots")
}

model KotLine {
  id              String   @id @default(uuid()) @db.Uuid
  kotId           String   @map("kot_id") @db.Uuid
  orderItemId     String   @map("order_item_id") @db.Uuid
  itemName        String   @map("item_name")
  variantName     String   @map("variant_name")
  quantity        Int
  addons          Json     @default("[]")
  comboComponents Json     @default("[]") @map("combo_components")
  note            String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  kot Kot @relation(fields: [kotId], references: [id])

  @@index([kotId])
  @@map("kot_lines")
}

model PrintJob {
  id         String         @id @default(uuid()) @db.Uuid
  outletId   String         @map("outlet_id") @db.Uuid
  printerId  String         @map("printer_id") @db.Uuid
  deviceId   String?        @map("device_id") @db.Uuid
  kotId      String?        @map("kot_id") @db.Uuid
  billId     String?        @map("bill_id") @db.Uuid
  kind       PrintJobKind
  payload    Json
  status     PrintJobStatus @default(PENDING)
  attempts   Int            @default(0)
  printedAt  DateTime?      @map("printed_at") @db.Timestamptz(3)
  /// Claimed by a device (or backing off after a failure) until this time.
  leaseUntil DateTime?      @map("lease_until") @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  printer Printer @relation(fields: [printerId], references: [id])
  kot     Kot?    @relation(fields: [kotId], references: [id], onDelete: SetNull)
  bill    Bill?   @relation(fields: [billId], references: [id], onDelete: SetNull)

  @@index([kotId])
  @@index([billId])
  @@index([deviceId, status])
  @@map("print_jobs")
}

/// Stored responses for retried requests (Idempotency-Key header).
model IdempotencyKey {
  id        String   @id @default(uuid()) @db.Uuid
  outletId  String   @map("outlet_id") @db.Uuid
  key       String
  response  Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([outletId, key])
  @@map("idempotency_keys")
}

enum BillStatus {
  OPEN
  PAID
  VOID
}

enum PaymentMode {
  CASH
  UPI
  CARD
}

enum DiscountKind {
  FLAT
  PERCENT
}

/// One printed bill. Amounts are paise and are written only from bill-calc.ts.
model Bill {
  id             String        @id @default(uuid()) @db.Uuid
  outletId       String        @map("outlet_id") @db.Uuid
  businessDayId  String        @map("business_day_id") @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  billNo         Int           @map("bill_no")
  financialYear  String        @map("financial_year")
  status         BillStatus    @default(OPEN)
  taxScheme      TaxScheme     @map("tax_scheme")
  grossSubtotal  Int           @map("gross_subtotal")
  itemDiscount   Int           @map("item_discount")
  subtotal       Int
  discountKind   DiscountKind? @map("discount_kind")
  discountValue  Int?          @map("discount_value")
  billDiscount   Int           @default(0) @map("bill_discount")
  discountReason String?       @map("discount_reason")
  discountById   String?       @map("discount_by_id") @db.Uuid
  /// Bill-level packaging (outlet setting, first parcel bill of an order).
  billPackaging  Int           @default(0) @map("bill_packaging")
  packaging      Int
  taxable        Int
  cgst           Int
  sgst           Int
  roundOff       Int           @map("round_off")
  total          Int
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz(3)
  voidReason     String?       @map("void_reason")
  voidedById     String?       @map("voided_by_id") @db.Uuid
  voidedAt       DateTime?     @map("voided_at") @db.Timestamptz(3)
  createdById    String        @map("created_by_id") @db.Uuid
  version        Int           @default(0)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlet      Outlet      @relation(fields: [outletId], references: [id])
  businessDay BusinessDay @relation(fields: [businessDayId], references: [id])
  order       Order       @relation(fields: [orderId], references: [id])
  createdBy   User        @relation("BillCreatedBy", fields: [createdById], references: [id])
  items       BillItem[]
  payments    Payment[]
  printJobs   PrintJob[]

  @@unique([outletId, financialYear, billNo])
  @@index([orderId])
  @@index([businessDayId, status])
  @@map("bills")
}

model BillItem {
  id                String        @id @default(uuid()) @db.Uuid
  billId            String        @map("bill_id") @db.Uuid
  orderItemId       String        @map("order_item_id") @db.Uuid
  itemName          String        @map("item_name")
  variantName       String        @map("variant_name")
  /// [{id, name, price}] copied from the order item.
  addons            Json          @default("[]")
  /// Per unit, add-ons included.
  unitPrice         Int           @map("unit_price")
  quantity          Int
  packagingPerUnit  Int           @map("packaging_per_unit")
  cgstBp            Int           @map("cgst_bp")
  sgstBp            Int           @map("sgst_bp")
  discountKind      DiscountKind? @map("discount_kind")
  discountValue     Int?          @map("discount_value")
  gross             Int
  itemDiscount      Int           @map("item_discount")
  lineTotal         Int           @map("line_total")
  billDiscountShare Int           @map("bill_discount_share")
  packaging         Int
  taxable           Int
  cgst              Int
  sgst              Int
  sortOrder         Int           @map("sort_order")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  bill      Bill      @relation(fields: [billId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([billId])
  @@index([orderItemId])
  @@map("bill_items")
}

model Payment {
  id                  String      @id @default(uuid()) @db.Uuid
  outletId            String      @map("outlet_id") @db.Uuid
  billId              String      @map("bill_id") @db.Uuid
  businessDayId       String      @map("business_day_id") @db.Uuid
  mode                PaymentMode
  amount              Int
  tendered            Int?
  change              Int?
  reference           String?
  receivedById        String      @map("received_by_id") @db.Uuid
  /// Set when the bill is voided: the money went back to the customer, on that business day.
  refundedAt          DateTime?   @map("refunded_at") @db.Timestamptz(3)
  refundedById        String?     @map("refunded_by_id") @db.Uuid
  refundBusinessDayId String?     @map("refund_business_day_id") @db.Uuid
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  bill        Bill         @relation(fields: [billId], references: [id])
  businessDay BusinessDay  @relation(fields: [businessDayId], references: [id])
  receivedBy  User         @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  refundedBy  User?        @relation("PaymentRefundedBy", fields: [refundedById], references: [id], onDelete: SetNull)
  refundDay   BusinessDay? @relation("PaymentRefundDay", fields: [refundBusinessDayId], references: [id])

  @@index([billId])
  @@index([businessDayId, mode])
  @@index([refundBusinessDayId])
  @@map("payments")
}

enum QrSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A phone that scanned a table's QR sticker. Ends when the table is vacated or after 8 hours.
model QrSession {
  id        String    @id @default(uuid()) @db.Uuid
  outletId  String    @map("outlet_id") @db.Uuid
  tableId   String    @map("table_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlet      Outlet         @relation(fields: [outletId], references: [id])
  table       DiningTable    @relation(fields: [tableId], references: [id])
  submissions QrSubmission[]

  @@index([tableId, endedAt])
  @@map("qr_sessions")
}

/// Dishes a customer asked for from their phone, waiting for staff to approve or reject.
model QrSubmission {
  id           String             @id @default(uuid()) @db.Uuid
  outletId     String             @map("outlet_id") @db.Uuid
  tableId      String             @map("table_id") @db.Uuid
  orderId      String             @map("order_id") @db.Uuid
  sessionId    String             @map("session_id") @db.Uuid
  status       QrSubmissionStatus @default(PENDING)
  /// [{variantId, quantity, addonIds, note, itemName, variantName, addons: [name], unitPrice}]
  lines        Json
  note         String?
  /// Preview in paise: dine-in prices with add-ons, before tax.
  total        Int
  decidedById  String?            @map("decided_by_id") @db.Uuid
  decidedAt    DateTime?          @map("decided_at") @db.Timestamptz(3)
  rejectReason String?            @map("reject_reason")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlet    Outlet      @relation(fields: [outletId], references: [id])
  table     DiningTable @relation(fields: [tableId], references: [id])
  order     Order       @relation(fields: [orderId], references: [id])
  session   QrSession   @relation(fields: [sessionId], references: [id])
  decidedBy User?       @relation("QrDecidedBy", fields: [decidedById], references: [id])

  @@index([orderId, status])
  @@index([outletId, status])
  @@index([sessionId, createdAt])
  @@map("qr_submissions")
}

enum ExpenseSource {
  MANUAL
  PURCHASE
}

/// What money was spent on. "Raw material" is a system category used by purchases.
model ExpenseCategory {
  id         String    @id @default(uuid()) @db.Uuid
  outletId   String    @map("outlet_id") @db.Uuid
  name       String
  /// Created by the system; cannot be renamed or archived.
  isSystem   Boolean   @default(false) @map("is_system")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlet   Outlet    @relation(fields: [outletId], references: [id])
  expenses Expense[]

  @@index([outletId])
  @@map("expense_categories")
}

/// Money spent during a business day. Never deleted; a mistake is voided with a reason.
model Expense {
  id            String        @id @default(uuid()) @db.Uuid
  outletId      String        @map("outlet_id") @db.Uuid
  businessDayId String        @map("business_day_id") @db.Uuid
  categoryId    String        @map("category_id") @db.Uuid
  /// Paise.
  amount        Int
  mode          PaymentMode
  note          String?
  source        ExpenseSource @default(MANUAL)
  /// Set when the expense was created by a purchase.
  purchaseId    String?       @unique @map("purchase_id") @db.Uuid
  createdById   String        @map("created_by_id") @db.Uuid
  voidedAt      DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidedById    String?       @map("voided_by_id") @db.Uuid
  voidReason    String?       @map("void_reason")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlet      Outlet          @relation(fields: [outletId], references: [id])
  businessDay BusinessDay     @relation(fields: [businessDayId], references: [id])
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  createdBy   User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  voidedBy    User?           @relation("ExpenseVoidedBy", fields: [voidedById], references: [id])
  purchase    Purchase?       @relation(fields: [purchaseId], references: [id])

  @@index([businessDayId])
  @@index([outletId, createdAt])
  @@map("expenses")
}

enum StockTxnType {
  PURCHASE
  PURCHASE_VOID
  ADJUST
  COUNT
}

/// A raw material the restaurant buys and counts (spec §1.2 #9). No recipe deduction.
model StockItem {
  id            String    @id @default(uuid()) @db.Uuid
  outletId      String    @map("outlet_id") @db.Uuid
  name          String
  unit          String
  /// Thousandths of the unit (1.5 kg = 1500). 0 means no low-stock alert.
  minLevelMilli Int       @default(0) @map("min_level_milli")
  /// Cache of the sum of the item's stock_txns, kept by postTxn only (spec §4.4.5).
  currentMilli  Int       @default(0) @map("current_milli")
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlet        Outlet         @relation(fields: [outletId], references: [id])
  txns          StockTxn[]
  purchaseLines PurchaseLine[]

  @@index([outletId])
  @@map("stock_items")
}

/// Every change to an item's stock, in signed thousandths of the unit.
model StockTxn {
  id          String       @id @default(uuid()) @db.Uuid
  outletId    String       @map("outlet_id") @db.Uuid
  stockItemId String       @map("stock_item_id") @db.Uuid
  type        StockTxnType
  qtyMilli    Int          @map("qty_milli")
  /// Paise paid, for purchases.
  amount      Int?
  purchaseId  String?      @map("purchase_id") @db.Uuid
  note        String?
  createdById String       @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  outlet    Outlet    @relation(fields: [outletId], references: [id])
  stockItem StockItem @relation(fields: [stockItemId], references: [id])
  purchase  Purchase? @relation(fields: [purchaseId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([stockItemId, createdAt])
  @@map("stock_txns")
}

/// Goods bought from a vendor, paid at once (no vendor ledger in v1).
model Purchase {
  id            String      @id @default(uuid()) @db.Uuid
  outletId      String      @map("outlet_id") @db.Uuid
  businessDayId String      @map("business_day_id") @db.Uuid
  vendorName    String      @map("vendor_name")
  billRef       String?     @map("bill_ref")
  paidMode      PaymentMode @map("paid_mode")
  /// Paise.
  total         Int
  note          String?
  createdById   String      @map("created_by_id") @db.Uuid
  voidedAt      DateTime?   @map("voided_at") @db.Timestamptz(3)
  voidedById    String?     @map("voided_by_id") @db.Uuid
  voidReason    String?     @map("void_reason")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlet      Outlet         @relation(fields: [outletId], references: [id])
  businessDay BusinessDay    @relation(fields: [businessDayId], references: [id])
  createdBy   User           @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  voidedBy    User?          @relation("PurchaseVoidedBy", fields: [voidedById], references: [id])
  lines       PurchaseLine[]
  txns        StockTxn[]
  expense     Expense?

  @@index([businessDayId])
  @@index([outletId, createdAt])
  @@map("purchases")
}

model PurchaseLine {
  id          String @id @default(uuid()) @db.Uuid
  purchaseId  String @map("purchase_id") @db.Uuid
  stockItemId String @map("stock_item_id") @db.Uuid
  qtyMilli    Int    @map("qty_milli")
  /// Paise for the line.
  amount      Int

  purchase  Purchase  @relation(fields: [purchaseId], references: [id])
  stockItem StockItem @relation(fields: [stockItemId], references: [id])

  @@index([purchaseId])
  @@map("purchase_lines")
}

/// Small images (dish photos, later the logo). The files live in Cloudflare R2 (or a local folder).
model Media {
  id        String   @id @default(uuid()) @db.Uuid
  outletId  String   @map("outlet_id") @db.Uuid
  mimeType  String   @map("mime_type")
  byteSize  Int      @map("byte_size")
  /// Object name in Cloudflare R2 or file name in the local folder: "<uuid>.webp".
  key       String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  outlet    Outlet   @relation("OutletMedia", fields: [outletId], references: [id])
  items     Item[]
  logoOf    Outlet[] @relation("OutletLogo")

  @@map("media")
}
