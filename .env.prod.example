# Copy to .env.prod and fill in. Never commit .env.prod.

# --- Database ---
POSTGRES_USER=rpos
# Letters and digits only: this value is embedded in a connection URL.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=rpos

# --- API ---
# At least 32 random characters. Changing it signs everyone out.
JWT_SECRET=change-me-to-at-least-32-random-characters
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8080

# --- First owner (used once by `pnpm db:seed`, see docs/deploy.md) ---
OWNER_NAME=Owner
OWNER_PHONE=
OWNER_PASSWORD=

# --- Web ---
HTTP_PORT=8080
# Only for HTTPS (docker-compose.tls.yml): your domain, e.g. pos.example.in. Needs HTTP_PORT=80.
DOMAIN=

# --- Backups ---
TZ=Asia/Kolkata
BACKUP_HOUR=02
BACKUP_RETENTION_DAYS=30
# Folder on the server where backups are written.
BACKUP_DIR=./backups
# When set, backups are encrypted with this passphrase. Store it somewhere safe off the server.
BACKUP_PASSPHRASE=
